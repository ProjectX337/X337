:root {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #111827;
  background: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
}

main {
  min-height: 100vh;
}

.hero {
  max-width: 960px;
  margin: 0 auto;
  padding: 120px 24px;
}

.eyebrow {
  margin: 0 0 16px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.6;
}

h1 {
  margin: 0;
  font-size: clamp(3rem, 8vw, 7rem);
  line-height: 0.95;
}

.description {
  max-width: 640px;
  margin-top: 32px;
  font-size: 1.25rem;
  line-height: 1.6;
  opacity: 0.75;
}
