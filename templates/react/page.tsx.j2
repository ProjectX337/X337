import AppShell from "../AppShell";

{% for component in components %}
import {{ component.name }} from "../components/{{ component.name }}";
{% endfor %}

export default function {{ page_name }}() {
  return (
    <AppShell>
      <main className="min-h-screen">
        <section className="space-y-4">
          <h1>{{ page_name }}</h1>

{% for component in components %}
          <{{ component.name }} />
{% endfor %}
        </section>
      </main>
    </AppShell>
  );
}
