from __future__ import annotations

from core.generators.generator_context import GeneratorContext
from core.generators.modules.base_module import BaseModule


class FeatureModule(BaseModule):
    """
    Generates the feature-level entry point.

    A feature always owns:

        frontend/src/features/<slug>/index.ts

    Feature pages and components are generated by their
    dedicated modules.
    """

    @property
    def name(self) -> str:
        return "features"

    def generate(self, context: GeneratorContext) -> None:
        features = getattr(context.spec, "feature_models", None)

        if not features:
            features = getattr(context.spec, "features", [])

        for feature in features:
            if isinstance(feature, str):
                slug = feature
                name = feature
                pages = []
            else:
                slug = getattr(feature, "slug", None)
                name = getattr(feature, "name", slug)
                pages = getattr(feature, "pages", [])

            if not slug:
                continue

            context.builder.template(
                template="react/feature/index.ts.j2",
                output=f"frontend/src/features/{slug}/index.ts",
                language="typescript",
                feature={
                    "slug": slug,
                    "name": name,
                    "pages": pages,
                },
            )
